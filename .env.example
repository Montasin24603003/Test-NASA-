# ==============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES (NEVER prefix secret keys with VITE_!)
# ==============================================================================

# 1. Hugging Face Authentication Token (Required for Inference Providers & Endpoints)
# Create a Fine-Grained Token at https://huggingface.co/settings/tokens
# Enable permission: "Make calls to Inference Providers"
HF_TOKEN=your_huggingface_token_here

# 2. Optional: Unified Hugging Face Space URL for PyTorch (.pth / .ckpt) Mars Models
# Deploy ./hf-mars-space to a Hugging Face Docker Space to serve:
#   - Mirali33/MOMO (vit-b-16/momo.pth)
#   - Mirali33/mars-bench-crater-binary-segmentation (model.ckpt)
#   - Mirali33/mars-bench-boulder-detection (model.ckpt)
#   - Mirali33/mars-bench-domars16k (model.ckpt)
#   - Mirali33/mars-bench-frost-classification (model.ckpt)
# Example: HF_SPACE_URL=https://your-username-mars-ai-hub.hf.space
HF_SPACE_URL=

# 3. Optional: Per-Model Custom Repository IDs or Dedicated Inference Endpoints
# Set any of these if you hosted fine-tuned Transformers models or Dedicated Endpoints:
HF_MOMO_REPO_ID=
HF_MOMO_ENDPOINT_URL=
HF_CRATER_REPO_ID=
HF_CRATER_ENDPOINT_URL=
HF_BOULDER_REPO_ID=
HF_BOULDER_ENDPOINT_URL=
HF_GEOLOGY_REPO_ID=
HF_GEOLOGY_ENDPOINT_URL=
HF_FROST_REPO_ID=
HF_FROST_ENDPOINT_URL=
HF_SEGFORMER_REPO_ID=
HF_SEGFORMER_ENDPOINT_URL=
HF_QWEN_REPO_ID=
HF_QWEN_ENDPOINT_URL=

# Optional request timeout in milliseconds (5000 - 120000, default 32000)
HF_REQUEST_TIMEOUT_MS=32000

# ==============================================================================
# AI Mission Advisor (Google Gemini) & NASA Open APIs
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
NASA_API_KEY=DEMO_KEY
